rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Auth helpers ──

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function employeeExists() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/employees/$(request.auth.uid));
    }

    function getEmployee() {
      return get(/databases/$(database)/documents/employees/$(request.auth.uid));
    }

    function hasPermission(perm) {
      return employeeExists() &&
        getEmployee().data.permissions.hasAny([perm]);
    }

    function isAdmin() {
      return employeeExists() && (
        getEmployee().data.permissions.hasAny(['employees', 'settings'])
      );
    }

    // ── Collection rules ──
    // Direct client SDK writes are blocked — all writes are proxied through the Express server.
    // Direct client reads require authentication to prevent open unauthenticated database dumping.

    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /sales/{saleId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /expenses/{expenseId} {
      allow read: if isSignedIn() && (hasPermission('expenses') || isAdmin());
      allow write: if false;
    }

    match /employees/{employeeId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /suppliers/{supplierId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /attendance/{attendanceId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /seasons/{seasonId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /metadata/{metadataId} {
      allow read: if isSignedIn() && isAdmin();
      allow write: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isSignedIn() && isAdmin();
      allow write: if false;
    }
  }
}
