# Google OAuth (for Firestore REST API proxy)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Gemini AI
GEMINI_API_KEY=

# Proxy Auth Secret (must match between server and client)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROXY_SECRET=
VITE_PROXY_SECRET=

# Default admin password for first-time setup (bootstrap)
VITE_DEFAULT_ADMIN_PASSWORD=

# CORS allowed origins (comma-separated, leave empty for development)
ALLOWED_ORIGINS=

# Firebase Applet Config (JSON string - optional, alternative to firebase-applet-config.json file)
# FIREBASE_APPLET_CONFIG={"apiKey":"...","projectId":"...",...}
