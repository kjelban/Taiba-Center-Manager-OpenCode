# === CLIENT-SIDE VARIABLES (Vite - bundled into frontend JS) ===
# These are PUBLIC by design (Firebase Web API keys are meant for client use).
# Security comes from Firestore Rules, not from hiding these values.

# Firebase Client Config (from Firebase Console > Project Settings > General)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
VITE_FIREBASE_DATABASE_ID=your_named_database_id

# === SERVER-SIDE VARIABLES (never exposed to client) ===

# Google OAuth (required for Firestore REST API access)
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REFRESH_TOKEN=your_refresh_token_here

# Firebase App Config (JSON string - used for server-side ID token verification)
# Get this from Firebase Console > Project Settings > General > Web API Key + config
FIREBASE_APPLET_CONFIG={"apiKey":"...","authDomain":"...","projectId":"..."}

# Bootstrap Password (server-side only - used for initial admin setup)
# This password is NEVER exposed to the client. It's validated server-side.
# Change this to a strong password before first deployment.
BOOTSTRAP_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Gemini AI (optional - enables AI features)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=3000
NODE_ENV=production

# CORS (comma-separated list of allowed origins, leave empty for Railway auto-detection)
ALLOWED_ORIGINS=
